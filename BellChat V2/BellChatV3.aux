\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Secure and accessible communication flow: asymmetric-key encryption and AI-based message adaptation according to the receiver's sensory profile. The message is encrypted at the source, decrypted on the server for accessible conversion, and re-encrypted before final delivery.}}{5}{}\protected@file@percent }
\newlabel{fig:flujo}{{2}{5}{}{figure.2}{}}
