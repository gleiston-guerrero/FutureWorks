  year={2013},
  volume={},
  number={},
  pages={407-410},
  abstract={User stories present the mean of communication between customer and development team in agile methods; this paper provides a new user stories voice aimed to ease and automate analysis of objects and their action from the user story using OOADARE (Object-oriented Analysis and Design Approach for the Requirements Engineering) approach [1]. OOADARE approach was also missing a communication mean with the customer; user stories with the new template will do the job.},
  keywords={Software;Object oriented modeling;Business;Object recognition;Economics;Industries;Computer science;User stories;agile method;user stories voice;object-oriented application;approach},
  doi={10.1109/INTECH.2013.6653681},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{7549299,
  author={Wautelet, Yves and Heng, Samedi and Kolp, Manuel and Mirbel, Isabelle and Poelmans, Stephan},
  booktitle={2016 IEEE Tenth International Conference on Research Challenges in Information Science (RCIS)}, 
  title={Building a rationale diagram for evaluating user story sets}, 
  year={2016},
  volume={},
  number={},
  pages={1-12},
  abstract={Requirements representation in agile methods is often done on the basis of User Stories (US) which are short sentences relating a WHO, WHAT and (possibly) WHY dimension. They are by nature very operational and simple to understand thus very efficient. Previous research allowed to build a unified model for US templates associating semantics to a set of keywords based on templates collected over the web and scientific literature. Since the semantic associated to these keywords is mostly issued of the i* framework we overview in this paper how to build a custom rationale diagram on the basis of a US set tagged using that unified template. The rationale diagram is strictly speaking not an i* strategic rationale diagram but uses parts of its constructs and visual notation to build various trees of relating US elements in a single project. Indeed, the benefits of editing such a rationale diagram is to identify depending US, identifying EPIC ones and group them around common Themes. The paper shows the feasibility of building the rationale diagram, then points to the use of these consistent sets of US for iteration content planning. To ensure the US set and the rationale diagram constitute a consistent and not concurrent whole, an integrated Computer-Aided Software Engineering (CASE) tool supports the approach.},
  keywords={Semantics;Visualization;Concrete;Electronic mail;Computer aided software engineering;User Story;User Story Template;Rationale Diagram;Agile Requirements Modeling;eXtreme Programming;SCRUM},
  doi={10.1109/RCIS.2016.7549299},
  ISSN={2151-1357},
  month={June},}@INPROCEEDINGS{11430311,
  author={Kumar, Bhawnesh and Dobhal, Dinesh C. and Dimri, Sushil Chandra and Rajput, Ishwari Singh and Jahan, Afsar},
  booktitle={2025 2nd International Conference on Advanced Computing and Emerging Technologies (ACET)}, 
  title={Analyzing User Story Quality and Sprint Velocity in Agile Projects Using NLP and Topic Modeling}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={As the requirements are written in the format of user story template for Scrum methodology in Agile Software Development (ASD). The quality of user stories is to be checked before going to implement by the Agile team. The unstructured and ambiguous user stories may lead to the Agile team performance down that delay the Agile project deadline. To improve the structure and semantic of user stories some more enhanced methodology can be introduced. This study investigates the relationship between user story quality and sprint velocity using Natural Language Processing (NLP), topic modelling, and unsupervised machine learning. Each story was labelled as either good or poor quality, with 92.4 % identified as good and 7.6 % as poor-quality. Description length and readability metrics were used to guide this labelling. Using KMeans clustering, stories were grouped into four optimized clusters to discover semantic cohesion. Additionally, Latent Dirichlet Allocation (LDA) was applied to extract key themes and topics from the user stories. LDA identified five dominant topics, with the highest semantic density (0.723) observed in Customer Access and Recovery, indicating tightly focused vocabulary, and the lowest (0.303) in Project Tracking and Feedback, suggesting greater variability. The velocity analysis shows that good-quality user stories tend to occur in sprints with higher velocity, typically in the range of $25-50$ story points, whereas poor-quality stories are more common in lower-velocity sprints. This supports the hypothesis that welldefined, detailed user stories enhance Agile team productivity and sprint outcomes. The findings emphasize the need for structured, semantically rich user stories and demonstrate how automated NLP-based methods can support story quality assessment and Agile project planning.},
  keywords={Productivity;Vocabulary;Semantics;Machine learning;Readability metrics;Natural language processing;Planning;Quality assessment;Resource management;Scrum (Software development);K-Means clustering;LDA;User story;Highest semantic density;Dominant topics;Sprint velocity},
  doi={10.1109/ACET67282.2025.11430311},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{6888731,
  author={Lin, Jun and Yu, Han and Shen, Zhiqi and Miao, Chunyan},
  booktitle={15th IEEE/ACIS International Conference on Software Engineering, Artificial Intelligence, Networking and Parallel/Distributed Computing (SNPD)}, 
  title={Using goal net to model user stories in agile software development}, 
  year={2014},
  volume={},
  number={},
  pages={1-6},
  abstract={Agile methodologies use user stories to capture software requirements. This often results in team members over emphasizing their understanding of the goals, without proper incorporation of goals from other stakeholders or customers. Existing UML or other goal oriented modeling methods tend to be overly complex for non-technical stakeholders to properly express their goals and communicate them to the agile team. In this paper, we propose a light weight Goal Net based method to model goal requirements in agile software development process to address this problem. It can be used to decompose complex processes into phased goals, and model low level user stories to high level hierarchy goal structures. Our preliminary analysis and studies in educational software engineering contexts show that it can improve agile team's group awareness to project goals and, thus, improve team productivity and artifact quality. The proposed approach was evaluated in university level agile software engineering projects. It has achieved an improvement of over 50 percentage points in terms of the proportion of high quality user stories generated by students compared to the standard user story template used in Scrum,},
  keywords={Mobile handsets;Software;Unified modeling language;Variable speed drives;Educational institutions;Software engineering;Mobile communication;Agile Software Development;Goal Net;Software Engineering},
  doi={10.1109/SNPD.2014.6888731},
  ISSN={},
  month={June},}@INPROCEEDINGS{10556185,
  author={Riquet, Nicolas and Devroey, Xavier and Vanderose, Benoît},
  booktitle={2024 IEEE/ACM International Conference on Technical Debt (TechDebt)}, 
  title={Debt Stories: Capturing Social and Technical Debt in the Industry}, 
  year={2024},
  volume={},
  number={},
  pages={40-44},
  abstract={In today’s organizations, software is mission-critical. However, the legacy of past decisions can make tasks related to artifacts increasingly inefficient or risky, creating debt. While most researchers and practitioners mainly focus on technical debt, some have investigated its social dimensions, known as social debt. We argue that organizations developing software need to tackle debt holistically, as it is intrinsically a socio-technical issue. In this short paper, we rely on a definition of socio-technical debt based on the existing literature to define Debt Stories: a tool based on the User Story format, that can help capture debt elements directly from the stake-holders involved in software development. A debt story includes information about the role of the stakeholder in the development process, the social or technical context, and the impact of the debt element on the different tasks performed by the stakeholder. We provide a first empirical evaluation of the usage of Debt Stories in an industrial context, demonstrating the relevance of Debt Stories to express and communicate socio-technical debt.CCS CONCEPTS• Software and its engineering → Agile software development, Software maintenance tools, • Social and professional topics →Software maintenance},
  keywords={Industries;Software maintenance;DevOps;Mission critical systems;Organizations;Production;Maintenance;socio-technical debt;debt stories;empirical software engineering},
  doi={},
  ISSN={},
  month={April},}@INPROCEEDINGS{7113575,
  author={Kamthan, Pankaj},
  booktitle={2015 12th International Conference on Information Technology - New Generations}, 
  title={Using Personas to Support the Goals in User Stories}, 
  year={2015},
  volume={},
  number={},
  pages={770-770},
  abstract={This paper proposes a conceptual framework, motivated by personas and composed of certain interrelated artifacts, to provide a better support for the goals included in the contents of structured user story statements.},
  keywords={Software systems;IEC standards;ISO standards;Software engineering;Context;agile methodology;artifact;ethnography;quality;software requirements engineering;traceability},
  doi={10.1109/ITNG.2015.136},
  ISSN={},
  month={April},}
