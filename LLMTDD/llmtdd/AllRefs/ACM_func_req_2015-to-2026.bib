editor = {Ivan Machado, Jos\'{e} Maldonado, Tayana Conte, Edna Canedo, Johnny Marques, Breno Bernard de Fran\c{c}a, Patr\'{\i}cia Matsubara, Davi Viana, Sergio Soares, Gleison Santos, Larissa Rocha, Bruno Gadelha, Rodrigo Santos, Ana Oran and Adolfo Gustavo Seca Neto},
