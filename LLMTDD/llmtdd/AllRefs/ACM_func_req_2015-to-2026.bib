abstract = {Software engineering is a fundamental sub-discipline of computer science, yet the teaching of the subject is not standardized enough to facilitate the sharing of teaching resources across institutions. This is highlighted by the diversity of topics which may be taught in software engineering courses. This issue is more evident in the realm of safety critical systems. If this problem can be alleviated by the establishment of a framework for developing software engineering teaching material (lectures, examinations, assignments, and course projects), pedagogy assessment then there would be an environment for the sharing and structuring of common software engineering artifacts for curricula design and development.},
booktitle = {Proceedings of the 2026 9th International Conference on Information and Computer Technologies},
pages = {424–430},
