  keywords={IEEE Standards;ISO Standards;IEC Standards;Requirements engineering;Reliability;Software engineering;Life cycle assessment;Systems engineering and theory;requirement;requirement characteristics;concept of operations;ConOps;operational concept;OpsCon;prototyping;system;system requirements specification;SRS.},
  doi={},
