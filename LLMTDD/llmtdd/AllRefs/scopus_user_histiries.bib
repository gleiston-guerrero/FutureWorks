@CONFERENCE{Sathsarani2025,
	author = {Sathsarani, Sanduni and Sandun, Yasitha and Rusith, Ravindu and Himaranga, Shakila and Kumari, Suriyaa and Supunya Swarnakantha, N.H.P. Ravi},
	title = {Agile User Story Builder: Transform Real-Time User Requirement Conversations into Well-Structured Agile User Stories},
	year = {2025},
	journal = {ICAC 2025 - 7th International Conference on Advancements in Computing: The Future of Computing; AI, Quantum, and Beyond},
	pages = {},
	doi = {10.1109/ICAC69156.2025.11361440},
	url = {https://www.scopus.com/pages/publications/105033600851?origin=resultslist},
	affiliations = {Department of Information Technology, Sri Lanka Institute of Information Technology, Malabe, Sri Lanka},
	abstract = {Agile software development methodologies rely heavily on well-structured user stories to bridge technical and business requirements. However, the traditional manual process of converting stakeholder conversations into structured user stories presents significant challenges including transcription errors, communication ambiguity, and inefficient processing. This research presents an automated Agile User Story Builder system that transforms requirement conversations into well-structured user stories. The system integrates cloud speech recognition, Natural Language Processing (NLP), machine learning, and Retrieval-Augmented Generation (RAG) for automated requirement processing within a microservices architecture. The system was developed using synthesized audio from 1,247 SRS documents (achieving 88% transcription accuracy) and validated on 75 real stakeholder conversations. Real-world validation demonstrates 78% speech-to-text accuracy (95% CI: 74-82%), 82% task classification precision, 73% reduction in manual documentation effort, and 86% format compliance in generated stories. The system achieves 20% timeline and 62% budget prediction improvement while providing measurable benefits including enhanced collaboration and streamlined Agile workflow efficiency. © 2025 IEEE.},
	author_keywords = {Agile Project Management; Machine Learning; Natural Language Processing; Requirements Engineering; User Story Generation},
	keywords = {Agile manufacturing systems; Automation; Budget control; Engineering education; Learning algorithms; Learning systems; Linguistics; Machine learning; Natural language processing systems; Project management; Software design; Speech communication; Speech recognition; Text processing; Transcription; Agile project management; Language processing; Machine-learning; Natural language processing; Natural languages; Real- time; Requirement engineering; Story generations; User stories; User story generation; Requirements engineering},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833156222-9},
	language = {English},
	abbrev_source_title = {ICAC - Int. Conf. Adv. Comput.: Future Comput,; AI, Quantum, Beyond},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Wu2022257,
	author = {Wu, Chao and Wang, Chunhui and Li, Tong and Zhai, Ye},
	title = {A Node-Merging based Approach for Generating iStar Models from User Stories},
	year = {2022},
	journal = {Proceedings of the International Conference on Software Engineering and Knowledge Engineering, SEKE},
	pages = {257 - 262},
	doi = {10.18293/SEKE2022-176},
	url = {https://www.scopus.com/pages/publications/85137153155?origin=resultslist},
	affiliations = {College of Computer Science and Technology, Inner Mongolia Normal University, Hohhot, China; Faculty of Information Technology, Beijing University of Technology, Bejing, China},
	abstract = {User story is a widely adopted requirement notation in agile development. Generally, user stories are written by customers or users in natural language with limited form to describe user's needs for the software system from their perspectives. However, since user stories are generally presented in a flat list, the relations derived from the user stories are difficult to capture. It reduces the understanding of the system as a whole. One solution to this problem is to build goal-oriented models that provide explicit relations among user stories. But extracting concepts and relationships from a large number of discrete user stories often take a lot of time for the agile development team. This paper proposes an iStar model generating approach based on node-merging from user stories. The method first extracts the iStar nodes from the semi-structured user stories, then uses a BERT (Bidirectional Encoder Representations from Transformers) model to measure the similarity between the nodes, and then nodes to be merged are identified and the edges between the iStar nodes are connected. Experiments are designed to illustrate the effectiveness of the proposed approach. © 2022 Knowledge Systems Institute Graduate School. All rights reserved.},
	author_keywords = {iStar; Model construction; User story},
	keywords = {Agile manufacturing systems; Knowledge engineering; Software engineering; Agile development; Development teams; Extracting concept; Goal-oriented modelling; Istar; Model construction; Natural languages; Software-systems; User need; User stories; Merging},
	correspondence_address = {C. Wang; College of Computer Science and Technology, Inner Mongolia Normal University, Hohhot, China; email: ciecwch@imnu.edu.cn},
	publisher = {Knowledge Systems Institute Graduate School},
	issn = {23259000},
	isbn = {1891706543; 978-189170654-7},
	language = {English},
	abbrev_source_title = {Proc. Int. Conf. Softw. Eng.  Knowl. Eng., SEKE},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 9; All Open Access; Bronze Open Access}
}

@ARTICLE{Malik2021,
	author = {Malik, Maryam Imtiaz and Sindhu, Muddassar Azam and Khattak, Akmal Saeed and Abbasi, Rabeeh Ayaz and Saleem, Khalid},
	title = {Automating test oracles from restricted natural language agile requirements},
	year = {2021},
	journal = {Expert Systems},
	volume = {38},
	number = {1},
	pages = {},
	doi = {10.1111/exsy.12608},
	url = {https://www.scopus.com/pages/publications/85088308770?origin=resultslist},
	affiliations = {Department of Computer Science, Quaid-i-Azam University, Islamabad, Pakistan},
	abstract = {Manual testing of software requirements written in natural language for agile or any other methodology requires more time and human resources. This leaves the testing process error prone and time consuming. For satisfied end users with bug-free software delivered on time, there is a need to automate the test oracle process for natural language or informal requirements. The automation of the test oracle is relatively easier with formal requirements, but this task is difficult to achieve with natural language requirements. This study proposes an approach called Restricted Natural Language Agile Requirements Testing (ReNaLART) to automate the test oracle from restricted natural language agile requirements. For this purpose, it uses an existing user story template with some modifications for writing user stories. This helps in identifying test input and expected output for a user story. For comparison of expected and observed outputs it makes use of a regex pattern and string distance functions. It is capable of assigning different types of verdicts automatically depending upon the similarity/dissimilarity between observed and expected outputs of user stories. ReNaLART is validated using several case studies of different domains, namely, OLX Pakistan, Mental Health Tests, McDelivery Pakistan, BlueStacks, Power Searching with Google, TensorFlow Playground, w3Schools 2018 offline and Touch'D. It revealed several faults in five of the above listed eight applications. Plus, the proposed test oracle on an average took 0.02 s for test data generation, expected output generation and verdict assignment. Both these facts show the fault revealing effectiveness and efficiency of ReNaLART. © 2020 John Wiley & Sons, Ltd},
	author_keywords = {agile requirements; automated test oracle; automated test-driven development; behaviour-driven development; restricted natural language},
	keywords = {Natural language processing systems; Testing; Agile requirements; Different domains; Distance functions; Effectiveness and efficiencies; Informal requirements; Natural language requirements; Software requirements; Test data generation; Software testing},
	correspondence_address = {M.A. Sindhu; Department of Computer Science, Quaid-i-Azam University, Islamabad, Pakistan; email: masindhu@qau.edu.pk},
	publisher = {Blackwell Publishing Ltd},
	issn = {02664720},
	coden = {EXSYE},
	language = {English},
	abbrev_source_title = {Expert Syst},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 11}
}

@CONFERENCE{Herwanto2025196,
	author = {Herwanto, Guntur Budi and Muhamad, Wicaksono Leksono and Maaroja, Waffiq},
	title = {Enhancing Automated User Story Quality Assessment with Large Language Models},
	year = {2025},
	journal = {Proceedings of 2025 IEEE International Conference on Data and Software Engineering, ICoDSE 2025},
	pages = {196 - 201},
	doi = {10.1109/ICoDSE68111.2025.11351886},
	url = {https://www.scopus.com/pages/publications/105033625734?origin=resultslist},
	affiliations = {Universitas Gadjah Mada, Department of Computer Science and Electronics, Yogyakarta, Indonesia},
	abstract = {User stories are a cornerstone of agile requirements engineering, and their quality is critical to project success. While frameworks like the Quality User Story (QUS) and tools like the Automatic Quality User Story Artisan (AQUSA) have advanced automated quality assessment, they remain limited to rigid templates and syntactic analysis, struggling with semantic and pragmatic criteria. This paper investigates the use of Large Language Models (LLMs) to overcome these limitations. We propose an augmented assessment pipeline where LLMs serve as a pre-processor to accurately extract components from non-standard user story templates and as an analyzer for complex semantic and pragmatic quality dimensions. Evaluated on a curated dataset of varied templates and the established Trident benchmark, our LLM-based approach significantly outperforms the rule-based AQUSA baseline in extraction accuracy and defect detection for criteria like Atomicity and Minimalism. The results demonstrate that LLMs offer a robust and generalizable path to more holistic automated user story quality assessment, reducing false positives and enabling teams to focus on higher-value tasks. © 2025 IEEE.},
	author_keywords = {LLM; Quality User Story Framework; User Stories},
	keywords = {Automation; Computational linguistics; Data quality; Quality control; Requirements engineering; Syntactics; Agile requirements; Language model; Large language model; Project success; Quality assessment; Quality user story framework; Requirement engineering; Template analysis; User stories; Semantics},
	correspondence_address = {G.B. Herwanto; Universitas Gadjah Mada, Department of Computer Science and Electronics, Yogyakarta, Indonesia; email: gunturbudi@ugm.ac.id},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833157578-6},
	language = {English},
	abbrev_source_title = {Proc. IEEE Int. Conf. Data Softw. Eng., ICoDSE},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

