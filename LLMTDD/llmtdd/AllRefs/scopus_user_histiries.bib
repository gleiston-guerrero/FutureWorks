@CONFERENCE{Kumar2025,
	author = {Kumar, Bhawnesh and Dobhal, Dinesh C. and Dimri, Sushil Chandra and Rajput, Ishwari Singh and Jahan, Afsar},
	title = {Analyzing User Story Quality and Sprint Velocity in Agile Projects Using NLP and Topic Modeling},
	year = {2025},
	journal = {2025 2nd International Conference on Advanced Computing and Emerging Technologies, ACET 2025},
	pages = {},
	doi = {10.1109/ACET67282.2025.11430311},
	url = {https://www.scopus.com/pages/publications/105037969946?origin=resultslist},
	affiliations = {Graphic Era Deemed To Be University, Department of Computer Science and Engineering, Uttarakhand, Dehradun, India; School of Computing, Graphic Era Hill University, Uttarakhand, Haldwani, India},
	abstract = {As the requirements are written in the format of user story template for Scrum methodology in Agile Software Development (ASD). The quality of user stories is to be checked before going to implement by the Agile team. The unstructured and ambiguous user stories may lead to the Agile team performance down that delay the Agile project deadline. To improve the structure and semantic of user stories some more enhanced methodology can be introduced. This study investigates the relationship between user story quality and sprint velocity using Natural Language Processing (NLP), topic modelling, and unsupervised machine learning. Each story was labelled as either good or poor quality, with 92.4% identified as good and 7.6% as poor-quality. Description length and readability metrics were used to guide this labelling. Using KMeans clustering, stories were grouped into four optimized clusters to discover semantic cohesion. Additionally, Latent Dirichlet Allocation (LDA) was applied to extract key themes and topics from the user stories. LDA identified five dominant topics, with the highest semantic density (0.723) observed in Customer Access and Recovery, indicating tightly focused vocabulary, and the lowest (0.303) in Project Tracking and Feedback, suggesting greater variability. The velocity analysis shows that good-quality user stories tend to occur in sprints with higher velocity, typically in the range of 25-50 story points, whereas poor-quality stories are more common in lower-velocity sprints. This supports the hypothesis that welldefined, detailed user stories enhance Agile team productivity and sprint outcomes. The findings emphasize the need for structured, semantically rich user stories and demonstrate how automated NLP-based methods can support story quality assessment and Agile project planning.  © 2025 IEEE.},
