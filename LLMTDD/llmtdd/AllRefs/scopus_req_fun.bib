@ARTICLE{Gobov202339,
	author = {Gobov, Denys and Zuieva, Oleksandra},
	title = {IDENTIFYING THE DEPENDENCIES BETWEEN IT PROJECT CONTEXT AND BUSINESS ANALYSIS DOCUMENT CONTENT},
	year = {2023},
	journal = {Innovative Technologies and Scientific Solutions for Industries},
	volume = {2023},
	number = {2},
	pages = {39 - 53},
	doi = {10.30837/ITSSI.2023.24.039},
	url = {https://www.scopus.com/pages/publications/105019085930?origin=resultslist},
	affiliations = {National Technical University of Ukraine "Igor Sikorsky Kyiv Polytechnic Institute", Department of Computer Science and Software Engineering of the Faculty of Informatics and Computer Science, Kyiv, Ukraine; CS Ltd, Kharkiv, Ukraine},
	abstract = {The subject matter of the article is software requirements documentation practices in IT projects. The goal of the work is to identify what information is included in business analysis deliverables and how the project context influences the content of business analysis documents. The following tasks were solved in the article: to examine the industrial standards and experience of business analysts and requirements engineers in requirements specification and modeling activities in software development, to create and conduct a survey on practices in requirement documentation activities in IT projects, to define practitioners’ preferences regarding business analysis documents’ content, and to define how project context influences document content. The following methods are used: three hundred and twenty-four practitioners from Ukrainian companies were surveyed about their current preferences in business analysis document creation, their experience, and project profile attributes in which techniques were used. The Chi-Square test of independence and Cramer’s V effect size measure were applied to define statistically significant dependencies between project context and business analysis document content. The following results were obtained: a list of the most commonly used elements in business analysis documents was defined. Seventy-eight statistically significant associations for pairs "project context – business analysis document content" were found based on the p-value of the Chi-Square test, for eighteen of which the significance of the identified dependencies was confirmed using the Cramer’s V effect size measure. Conclusions: It is concluded that project context influences the content of business analysis documents in IT projects. The most influential factors are the business analyst’s experience, team distribution, company size and type, template usage, and the purpose of using the requirements documents. The found dependencies can guide the selection of business analysis document structure and the creation of project-specific templates during the creation business analysis approach and business analysis information management approach. © D. Gobov, O. Zuieva, 2023.},
	author_keywords = {business analysis document; Cramer V; empirical study; project context; requirements engineering},
	publisher = {Kharkiv National University of Radio Electronics},
	issn = {25229818},
	language = {English},
	abbrev_source_title = {Innovative technol. sci. solut. ind.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access; Gold Open Access; Green Open Access}
}

@CONFERENCE{Liu2026554,
	author = {Liu, Haitao and Longani, Pattama},
	title = {A Framework to Identify Functional Consistency Issue between User Requirements Specifications and Software Requirements Specifications},
	year = {2026},
	journal = {2026 8th International Conference on Natural Language Processing, ICNLP 2026},
	pages = {554 - 560},
	doi = {10.1109/ICNLP69856.2026.11527516},
	url = {https://www.scopus.com/pages/publications/105041793637?origin=resultslist},
	affiliations = {Chiang Mai University, College of Arts, Media, and Technology, Chiang Mai, Thailand},
	abstract = {In large-scale software engineering, functional consistency issues between User Requirements Specifications (URS) and Software Requirements Specifications (SRS) often lead to implementation deviations and rework. However, semantic sparsity, syntactic variations, and domain terminology diversity make reliable consistency identification extremely challenging. To address this issue, we propose a method that combines multi-level semantic similarity computation with logical constraints. This method first uses a semantic similarity gate based on SentenceBERT embeddings to capture high-level semantic equivalence; Then, BM25 and lexical semantics are used to model term-level relevance and identify latent semantic correspondences between heterogeneous requirement expressions. To adapt to the specific characteristics of the datasets, a sliding threshold is introduced at each stage, enabling adaptive decision boundaries across different datasets. Finally, logical constraints are used to identify whether functional consistency issues exist in the requirements. Experimental results on four different datasets demonstrate that the proposed framework effectively balances precision and recall, achieving good performance on multiple evaluation metrics, including F1 score and Matthews' correlation coefficient. The results confirm that our method can significantly improve the performance of functional consistency detection. © 2026 IEEE.},
	author_keywords = {Functional Consistency; Natural Language Processing; Semantic Similarity; Software Requirements Specification},
	keywords = {Formal specification; Latent semantic analysis; Requirements engineering; Semantics; Syntactics; Functional consistency; Functionals; Language processing; Logical constraints; Natural language processing; Natural languages; Semantic similarity; Software requirements specifications; Specification requirement; User requirement specifications; Natural language processing systems},
	correspondence_address = {H. Liu; Chiang Mai University, College of Arts, Media, and Technology, Chiang Mai, Thailand; email: haitao_l@cmu.ac.th},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833158226-5},
	language = {English},
	abbrev_source_title = {Int. Conf. Nat.l Lang. Process., ICNLP},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Zaki-Ismail2021110,
	author = {Zaki-Ismail, Aya and Osama, Mohamed and Abdelrazek, Mohamed and Grundy, John and Ibrahim, Amani},
	title = {RCM: Requirement capturing model for automated requirements formalisation},
	year = {2021},
	journal = {MODELSWARD 2021 - Proceedings of the 9th International Conference on Model-Driven Engineering and Software Development},
	pages = {110 - 121},
	url = {https://www.scopus.com/pages/publications/85102991179?origin=resultslist},
	affiliations = {Information Technology Institute, Deakin University, 3125 Burwood Hwy, VIC, Australia; Information Technology Institute, Monash University, 3800 Wellington Rd., VIC, Australia},
	abstract = {Most existing automated requirements formalisation techniques require system engineers to (re)write their requirements using a set of predefined requirement templates with a fixed structure and known semantics to simplify the formalisation process. However, these techniques require understanding and memorising requirement templates, which are usually fixed format, limit requirements captured, and do not allow capture of more diverse requirements. To address these limitations, we need a reference model that captures key requirement details regardless of their structure, format or order. Then, using NLP techniques we can transform textual requirements into the reference model. Finally, using a suite of transformation rules we can then convert these requirements into formal notations. In this paper, we introduce the first and key step in this process, a Requirement Capturing Model (RCM) - as a reference model - to model the key elements of a system requirement regardless of their format, or order. We evaluated the robustness of the RCM model compared to 15 existing requirements representation approaches and a benchmark of 162 requirements. Our evaluation shows that RCM breakdowns support a wider range of requirements formats compared to the existing approaches. We also implemented a suite of transformation rules that transforms RCM-based requirements into temporal logic(s). In the future, we will develop NLP-based RCM extraction technique to provide end-to-end solution. Copyright © 2021 by SCITEPRESS – Science and Technology Publications, Lda. All rights reserved.},
	author_keywords = {Requirement engineering; Requirement formalisation; Requirement modeling; Requirement representation},
	keywords = {Natural language processing systems; Semantics; End-to-end solutions; Extraction techniques; Formal notations; Reference modeling; Requirement capturing; System engineers; System requirements; Transformation rules; Software design},
	editor = {Hammoudi S. and Pires L.F. and Seidewitz E. and Soley R.},
	publisher = {SciTePress},
	isbn = {978-989758487-9},
	language = {English},
	abbrev_source_title = {MODELSWARD - Proc. Int. Conf. Model-Driven Eng. Softw. Dev.},
	type = {Conference paper},
