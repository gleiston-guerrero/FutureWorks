	note = {Cited by: 0}
}

@CONFERENCE{Yildirim2025484,
	author = {Yildirim, Savas and Cevik, Mucahit and Basar, Ayse},
	title = {Adaptive Fine-Tuning for Multi-Class Classification Over Software Requirement Data},
	year = {2025},
	journal = {Proceedings - 2025 IEEE International Conference on Collaborative Advances in Software and Computing, CASCON 2025},
	pages = {484 - 493},
	doi = {10.1109/CASCON66301.2025.00078},
	url = {https://www.scopus.com/pages/publications/105033221944?origin=resultslist},
	affiliations = {Istanbul Bilgi University, Computer Engineering Department, Istanbul, Turkey; Toronto Metropolitan University, Data Science Lab, Toronto, Canada},
	abstract = {The analysis of software requirement specifications (SRS) using Natural Language Processing (NLP) methods has been an important study area in the software engineering field in recent years. Especially thanks to the advances brought by deep learning and transfer learning approaches in NLP, SRS data can be utilized for various learning tasks more easily. In this study, we employ a three-stage domain-adaptive fine-tuning approach for three prediction tasks regarding software requirements, which improve the model robustness on a real distribution shift. The multi-class classification tasks involve predicting the type, priority and severity of the requirement texts specified by the users. We compare our results with strong classification baselines such as word embedding pooling and Sentence BERT, and show that the adaptive fine-tuning leads to performance improvements across the tasks. We find that an adaptively fine-tuned model can be specialized to a particular data distribution, which is able to generate accurate results and learns from abundantly available textual data in software engineering task management systems. © 2025 IEEE.},
	author_keywords = {domain adaptation; Software Requirement Specification (SRS); transfer learning; Transformers},
	keywords = {Classification (of information); Deep learning; Information management; Learning algorithms; Learning systems; Requirements engineering; Software engineering; Specifications; Text processing; Tuning; Adaptive fine-tuning; Domain adaptation; Language processing; Multi-class classification; Natural languages; Software requirement specification; Software requirements; Software requirements specifications; Transfer learning; Transformer; Transfer learning},
	editor = {Muller H.A. and Zou Y. and Bradbury J. and Stroulia E.},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833159948-5},
	language = {English},
	abbrev_source_title = {Proc. - IEEE Int. Conf. Collab. Adv. Softw. Comput., CASCON},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Haris2020142,
	author = {Haris, M Syauqi and Kurniawan, Tri Astoto},
	title = {Automated requirement sentences extraction from software requirement specification document},
