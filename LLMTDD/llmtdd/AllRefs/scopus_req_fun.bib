@CONFERENCE{Nishiwaki202549,
	author = {Nishiwaki, Yasuto and Fukushima, Kenta and Karatsuya, Kazuyoshi and Tsuda, Kazuhiko},
	title = {A consideration of Information Extraction Techniques for highly uncertain information in Agile Development},
	year = {2025},
	journal = {Proceedings - IIAI-AAI-Winter 2025 - 2025 19th IIAI International Congress on Advanced Applied Informatics},
	pages = {49 - 54},
	doi = {10.1109/IIAI-AAI-Winter69777.2025.00018},
	url = {https://www.scopus.com/pages/publications/105036198096?origin=resultslist},
	affiliations = {Applications Services Division, Hitachi,Ltd, Kanagawa, Japan; Faculty of Business Sciences, University of Tsukuba, Tokyo, Japan},
	abstract = {In recent years, Japan’s domestic workforce has been rapidly declining, leading to increased use of global resources in system development. In the 2000s, Japan-style offshore development, mainly in China, leveraged cost and time differences. Since the COVID-19 pandemic, remote collaboration and cloud-based system development have become more common. In Japan, the Waterfall model is still the mainstream, but globally, there are many projects that apply Agile development processes, especially Scrum. On the other hand, when defining requirements on the Japan side and developing them globally, there are various gaps such as language gaps, cultural differences, ways of thinking about resource application, and teaming, and it is an urgent issue to solve them. In particular, it is an important task to correctly understand the requirements that are the basis of system development and to complete from the development to testing. From this perspective, the key is not only to bridge the language gap in communication, but also to communicate specifications from the domestic to the global side. Therefore, this study examined methods to mitigate misunderstandings regarding requirements and specifications, based on a case study of a system development project involving collaboration with global resources. In the Agile development process, the requirements are incorporated into a User Story. Then, define the Acceptance Criteria in the User Story. For this reason, it is important to focus on these Acceptance Criteria and investigate what kind of sentences the clarity and ambiguity of the required specifications occurred. This study explained expressions and sentences that contain a high degree of uncertainty and ambiguity. It is evaluated pattern formation in terms of relevance and pattern formation in word endings, and evaluates methods that lead to a reduction in errors. This paper presented a perspective for product owners to understand, define, accept and verify the requirements in future system development centered on Agile development process. Japan's demographic decline has accelerated the use of global resources in software development, which introduces language and cultural gaps. These gaps increase ambiguity in requirement specifications, making early detection of unclear Acceptance Criteria critical for reducing defects and rework. This context highlights the importance of addressing ambiguity in Acceptance Criteria. ©2025 IEEE.},
	author_keywords = {Acceptance criteria; Agile development; Ambiguous; Natural Language Processing; Uncertain information},
	keywords = {Agile manufacturing systems; Information retrieval; Population statistics; Requirements engineering; Software design; Specifications; Acceptance criteria; Agile development; Ambiguous; Development process; Global resources; Language processing; Natural language processing; Natural languages; System development; Uncertain informations; Natural language processing systems},
	correspondence_address = {Y. Nishiwaki; Applications Services Division, Hitachi,Ltd, Kanagawa, Japan; email: yasuto.nishiwaki.sb@hitachi.com},
	editor = {Matsuo T. and Takamatsu T. and Ono Y.},
