	keywords = {Cryptography; Ontology; Semantics; Specifications; Verification; Web services; Critical software; Engineering community; Ontology-based; Requirement engineering; Security requirements; Software security; Software security requirement; Software vulnerabilities; Verification-and-validation; Requirements engineering},
