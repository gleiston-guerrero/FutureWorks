	year = {2022},
	journal = {Proceedings - 2022 2nd International Conference on Electronic and Electrical Engineering and Intelligent System, ICE3IS 2022},
	pages = {328 - 333},
	doi = {10.1109/ICE3IS56585.2022.10010259},
