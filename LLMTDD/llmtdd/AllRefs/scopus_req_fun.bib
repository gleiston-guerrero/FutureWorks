@CONFERENCE{Winter20041359,
	author = {Winter, Robert and Strauch, Bernhard},
	title = {Information requirements engineering for data warehouse systems},
	year = {2004},
	journal = {Proceedings of the ACM Symposium on Applied Computing},
	volume = {2},
	pages = {1359 - 1365},
