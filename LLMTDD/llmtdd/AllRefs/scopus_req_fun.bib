@CONFERENCE{Henkel2024193,
	author = {Henkel, Elisabeth and Hauff, Nico and Funk, Lena and Langenfeld, Vincent and Podelski, Andreas},
	title = {Scalable Redundancy Detection for Real-Time Requirements},
	year = {2024},
	journal = {Proceedings of the IEEE International Conference on Requirements Engineering},
