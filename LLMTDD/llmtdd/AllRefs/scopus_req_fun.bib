@CONFERENCE{Vasques2019624,
	author = {Vasques, D.G. and Santos, G.S. and Gomes, F.D. and Galindo, J.F. and Martins, P.S.},
	title = {Use Case Extraction through Knowledge Acquisition},
	year = {2019},
	journal = {2019 IEEE 10th Annual Information Technology, Electronics and Mobile Communication Conference, IEMCON 2019},
	pages = {624 - 631},
	doi = {10.1109/IEMCON.2019.8936279},
	url = {https://www.scopus.com/pages/publications/85077960048?origin=resultslist},
	affiliations = {University of São Paulo, USP, ICMC, São Carlos, Brazil; University of Campinas, UNICAMP, School of Technology, Limeira, Brazil; Federal Univ of Mato Grosso Do sul, UFMS/CPTL, Três Lagoas, Brazil},
	abstract = {Most challenges in requirements analysis and use case extraction are related to the correct comprehension of clients' core processes and activities, as well as their needs. This information is usually available in documents, such as the business vision, written in natural language. This kind of language may lead to interpretation bias and information loss, thus causing project delays and escalation of costs. In order to overcome natural language interpretation challenges in Requirements Engineering, we propose the use of Verbka, a knowledge acquisition process based on verbal semantics, as a complement to traditional requirements analysis. This process extracts the causal relationships among the actors mentioned in the business vision document. We used this process as a use case pre-modeling tool, aiming to minimize subjectivity in the identification of actors and use cases. We tested Verbka using a business vision from a classical textbook. The results show that this process is able to obtain a list containing all requirements defined by the client, all actors involved in the business vision, and how they interact with each other. This process is systematic and provides a textual and visual representation of user requirements and use cases consistently. Its application reduced interpretation bias, thus allowing a more detailed and structured requirements analysis. © 2019 IEEE.},
	author_keywords = {Business Modeling; Concept Maps; Natural Language Processing; Requirements Analysis; Semantics; UML},
	keywords = {Extraction; Knowledge acquisition; Mobile telecommunication systems; Natural language processing systems; Requirements engineering; Semantics; Systems engineering; Acquisition process; Business modeling; Causal relationships; Concept maps; NAtural language processing; Natural languages; Requirements analysis; Visual representations; Modeling languages},
	editor = {Chakrabarti S. and Saha H.N.},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {978-172812530-5},
	language = {English},
	abbrev_source_title = {IEEE Annu. Inf. Technol., Electron. Mob. Commun. Conf., IEMCON},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

