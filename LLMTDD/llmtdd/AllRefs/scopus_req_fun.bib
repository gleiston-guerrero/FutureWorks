	keywords = {Artificial intelligence; Query processing; Requirements engineering; Syntactics; Verification; Consistency checks; Dynamic ontologies; Inconsistency detection; Ontology's; Reasoners; Requirement boilerplate; Requirement engineering; Requirements validation; Software requirements; SPARQL query; Ontology},
