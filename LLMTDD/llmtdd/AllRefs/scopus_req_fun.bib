@CONFERENCE{Zhao201121,
	author = {Zhao, Liping},
	title = {A pattern language for evolving scenarios into multi-perspective models for requirements specification: Research preview},
	year = {2011},
	journal = {2011 1st International Workshop on Requirements Patterns, RePa'11},
	pages = {21 - 27},
