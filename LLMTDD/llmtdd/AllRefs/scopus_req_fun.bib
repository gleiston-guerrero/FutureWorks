	title = {Combining object-oriented paradigm and controlled natural language for requirements specification},
	year = {2021},
	journal = {BCNC 2021 - Proceedings of the 1st ACM SIGPLAN International Workshop on Beyond Code: No Code, co-located with SPLASH 2021},
