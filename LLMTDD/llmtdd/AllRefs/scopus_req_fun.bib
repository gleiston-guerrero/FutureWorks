	title = {Probing for requirements knowledge to stimulate architectural thinking},
	year = {2016},
	journal = {Proceedings - International Conference on Software Engineering},
	volume = {14-22-May-2016},
	pages = {843 - 854},
	doi = {10.1145/2884781.2884801},
