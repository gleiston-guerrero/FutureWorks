@CONFERENCE{Hesse201630,
	author = {Hesse, Tom-Michael and Kuehlwein, Arthur and Roehm, Tobias},
	title = {DecDoc: A Tool for Documenting Design Decisions Collaboratively and Incrementally},
	year = {2016},
	journal = {Proceedings - 2016 1st International Workshop on Decision Making in Software ARCHitecture, MARCH 2016},
	pages = {30 - 37},
	doi = {10.1109/MARCH.2016.9},
	url = {https://www.scopus.com/pages/publications/84979516664?origin=resultslist},
	affiliations = {Heidelberg University, Im Neuenheimer Feld 205, Heidelberg, 69120, Germany; CQSE GmbH, Lichtenbergstrasse 8, Garching b. Mönchen, 85748, Germany},
	abstract = {The outcome and quality of design decisions highly depend on the knowledge reflected during decision-making. Typically, making design decisions is not one singular action.Instead, developers discuss and cooperate during requirements engineering, design and implementation of a system to make and adapt design decisions. This decision-making process is influenced by different decision-making strategies, personal experiences, and biases. In consequence, decision-related knowledge emerges incrementally over time in an incomplete and heterogeneous way. This hinders the documentation of such knowledge in practice. First, most documentation tools capture decision-related knowledge within one particular development activity.However, they do not focus on the collaborative and shared documentation during multiple activities. Second, static documentation templates and formal rules are not suitable for capturing incomplete knowledge, as additional documentation effort is imposed for developers. Thus, text templates are not used or filled with generic contents. As a result, decision-related knowledge remains implicit and is not available to guide future decision-making. To address these issues, we have created the tool DecDoc based on our incremental documentation model. The tool enables developers to capture decision-related knowledge and collaborate on a comprehensive documentation of design decisions with relations to artifacts, such as requirement specifications, design diagrams, and code. This helps to improve the decision-making process for design decisions, as it helps to make explicit and reflect related knowledge during the process. In this paper, we present DecDoc with regard to requirements from the decision-making process.Then, we describe its application on design decisions in example projects. Finally, we discuss our insights from using the tool and highlight open challenges. © 2016 IEEE.},
	author_keywords = {Decision Capturing; Decision documentation; Decision Knowledge; Design Decision-Making; Design Decisions; Design Documentation; Knowledge representation},
	keywords = {Decision making; Knowledge based systems; Knowledge representation; Software architecture; Decision Capturing; Decision Knowledge; Design decision-making; Design decisions; Design documentation; Design},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {978-150902573-2},
	language = {English},
	abbrev_source_title = {Proc. - Int. Workshop Decis. Mak. Softw. ARCHit., MARCH},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 17}
}

