@ARTICLE{ERLANSYAH20259575,
	author = {ERLANSYAH, NAUVAL FAKSI and OKTAVIA, TANTY},
	title = {COMBINING THE USER-CENTERED DESIGN METHOD WITH REQUIREMENT ENGINEERING TO IMPROVE USABILITY IN WEB-BASED APPLICATION},
	year = {2025},
	journal = {Journal of Theoretical and Applied Information Technology},
