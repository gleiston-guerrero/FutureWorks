	year = {2025},
	journal = {Proceedings - 2025 IEEE 33rd International Requirements Engineering Conference Workshops, REW 2025},
	pages = {40 - 48},
	doi = {10.1109/REW66121.2025.00010},
	url = {https://www.scopus.com/pages/publications/105020907031?origin=resultslist},
	affiliations = {Wellesley College, Computer Science Department, Wellesley, MA, United States; Carnegie Mellon University, Software and Societal Systems Dept., Pittsburgh, PA, United States},
	abstract = {Requirements engineering often relies on legal and regulatory texts to define system constraints, but translating legal language into formal requirements requires attention to rules for interpreting legal prose. Automating this translation can significantly improve efficiency and consistency, particularly in highly regulated domains such as privacy and security law. While prior research has explored natural language processing techniques for requirements extraction from law, existing methods struggle with the ambiguity and variability of legal language. In this paper, we automate the process of translating legal text into a legal domain-specific language (DSL) called the legal requirements specification language (LRSL) using a combined approach of fine-tuned generative large language models (LLMs) and an algorithm that adds inter-sentence relations using a rule-based post-processing algorithm. We also present an LLM performance testing approach that quantifies the quality of model-generated DSL fragments. Automating the process of translating legal text into a DSL could allow for more timely assessment of new laws for emerging and novel requirements.  © 2025 IEEE.},
