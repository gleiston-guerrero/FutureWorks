@CONFERENCE{Melani2025,
	author = {Melani, Beatrice and Diglio, Antonello and Fabbroni, Davide},
	title = {Aided Requirement Specification for Formal Requirement Validation},
	year = {2025},
	journal = {ISSE 2025 - 11th IEEE International Symposium on Systems Engineering, Symposium Proceedings},
	pages = {},
	doi = {10.1109/ISSE65546.2025.11370105},
	url = {https://www.scopus.com/pages/publications/105034966427?origin=resultslist},
	affiliations = {Politecnico di Milano, Milan, Italy; Flight Control System, Leonardo Helicopters, Varese, Italy},
	abstract = {Requirements engineering is an interdisciplinary activity that encompasses the entire concept and development phases of a project. According to the ISO/IEC/IEEE 29148 International Standard [1]: 'requirements engineering is concerned with discovering, eliciting, developing, analyzing, determining verification methods, validating, communicating, documenting, and managing requirements.' In fact, it is essential for the success of a project that requirements are managed correctly, especially when dealing with complex and safety-critical systems. We propose a process for the specification and automatic validation of requirements. The ultimate objective is to implement a tool that can fit seamlessly into the development process, with direct links to the functional architecture in a visual modeling tool and the requirement documents in a requirements management tool. The focus of this paper is on the underlying principles that the tool should be based on: (i) requirements patterns that constrain the requirements definition to a structured form to support the partial automation of the validation process. (ii) a data-dictionary that can be imported from the architecture modeling tool to avoid the potential ambiguity of the natural language as well as to support even further the automation of the validation process. (iii) Automatic translation of the constrained natural language requirements obtained from the patterns into both Signal Temporal Logic (STL) expressions and natural language (NL) statements. (iv) Automatic consistency check on the requirements set (including temporal requirements) and coverage check to ensure that all necessary information is included. The result is a set of requirements that is constantly validated against predefined metrics during the writing process, creating an aided requirements specification process. © 2025 IEEE.},
	author_keywords = {completeness; consistency; Requirements specification; requirements validation; Signal Temporal Logic},
	keywords = {Artificial intelligence; Automation; Formal specification; ISO Standards; Natural language processing systems; Requirements engineering; Temporal logic; Completeness; Consistency; Interdisciplinary activities; Modelling tools; Natural languages; Requirement engineering; Requirements specifications; Requirements validation; Signal temporal logic; Validation process; Safety engineering},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833157550-2},
	language = {English},
	abbrev_source_title = {ISSE - IEEE Int. Symp. Syst. Eng., Symp. Proc.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

