	title = {Multioracle coevolutionary learning of requirements specifications from examples in on-the-fly markets},
	year = {2019},
	journal = {Evolutionary Computation},
	volume = {28},
	number = {2},
	pages = {165 - 193},
	doi = {10.1162/evco_a_00266},
