	keywords = {Cost benefit analysis; Requirements engineering; Automotives; Consensus buildings; Goal structuring notation; Goal strucuturing notation; Model based development; Requirements acquisition; Requirements elicitation; Requirements specifications; Specifications document; System concepts; Specifications},
	publisher = {IEEE Computer Society},
