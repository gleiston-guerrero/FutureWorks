}

@CONFERENCE{Knote2016,
	author = {Knote, Robin and Baraki, Harun and Söllner, Matthias and Geihs, Kurt and Leimeister, Jan Marco},
	title = {From requirement to design patterns for ubiquitous computing applications},
	year = {2016},
	journal = {ACM International Conference Proceeding Series},
	pages = {},
	doi = {10.1145/3011784.3011812},
	url = {https://www.scopus.com/pages/publications/85015164194?origin=resultslist},
	affiliations = {Research Center for Information System Design (ITeG), University of Kassel, Pfannkuchstr. 1, Kassel, 34121, Germany},
	abstract = {Ubiquitous Computing describes a concept where computing appears around us at any time and any location. Respective systems rely on context-sensitivity and adaptability. This means that they constantly collect data of the user and his context to adapt its functionalities to certain situations. Hence, the development of Ubiquitous Computing systems is not only a technical issue and must be considered from a privacy, legal and usability perspective, too. This indicates a need for several experts from different disciplines to participate in the development process, mentioning requirements and evaluating design alternatives. In order to capture the knowledge of these interdisciplinary teams to make it reusable for similar problems, a pattern logic can be applied. In the early phase of a development project, requirement patterns are used to describe recurring requirements for similar problems, whereas in a more advanced development phase, design patterns are deployed to find a suitable design for recurring requirements. However, existing literature does not give sufficient insights on how both concepts are related and how the process of deriving design patterns from requirements (patterns) appears in practice. In our work, we give insights on how trust-related requirements for Ubiquitous Computing applications evolve to interdisciplinary design patterns. We elaborate on a six-step process using an example requirement pattern. With this contribution, we shed light on the relation of interdisciplinary requirement and design patterns and provide experienced practitioners and scholars regarding UC application development a way for systematic and effective pattern utilization. © 2016 ACM.},
	author_keywords = {Requirement Patterns; Requirements Engineering},
	keywords = {Computation theory; Computer software reusability; Design; Intelligent buildings; Requirements engineering; Advanced development phase; Computing applications; Design alternatives; Development process; Inter-disciplinary designs; Interdisciplinary teams; Requirement Patterns; Ubiquitous computing systems; Ubiquitous computing},
