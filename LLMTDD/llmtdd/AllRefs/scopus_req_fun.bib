@CONFERENCE{Fergencs2020235,
	author = {Fergencs, Tamás and Illés, Dominika and Pilawka, Olga and Meier, Florian},
	title = {Human-centered humanities: Using stimulus material for requirements elicitation in the design process of a digital archive},
