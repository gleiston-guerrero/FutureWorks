	affiliations = {Srm Institute of Science & Technology, Department of Computer Science and Engineering, Delhi NCR Campus, U.P., Ghaziabad, India; Scriet, Ccs University, U.P, Meerut, India},
	abstract = {Natural Language Processing (NLP) has emerged as a transformative tool in software engineering, particularly in automating test case generation (ATCG). Traditional ATCG approaches are limited to structured requirements (e.g., Cause-Condition-Effect formats), leaving unstructured, real-world specifications unaddressed. This paper proposes a novel NLP-based methodology to extract test cases from unrestricted software requirement documents (SRS) using a hybrid pipeline of language models (BERT, GPT) and rule-based techniques (NER, dependency parsing). Our approach addresses ambiguity and domain variability by integrating semantic analysis, constraint extraction, and machine learning-based validation. Experimental results across three domains (University, HR, and Coal Mine Management Systems) demonstrate 85-87% accuracy and 30-40% effort reduction compared to manual generation, while identifying key challenges like implicit requirements and contextual gaps. This work bridges the critical gap between unstructured client inputs and actionable test cases, enabling early-stage testing in Agile workflows.  © 2025 IEEE.},
