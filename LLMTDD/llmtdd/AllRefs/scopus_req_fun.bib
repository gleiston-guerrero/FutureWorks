	title = {Towards Perspective-Based Specification of Machine Learning-Enabled Systems},
	year = {2022},
	journal = {Proceedings - 48th Euromicro Conference on Software Engineering and Advanced Applications, SEAA 2022},
	pages = {112 - 115},
