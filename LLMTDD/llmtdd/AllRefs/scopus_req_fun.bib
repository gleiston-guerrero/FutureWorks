@CONFERENCE{Pudlitz2019211,
	author = {Pudlitz, Florian and Brokhausen, Florian and Vogelsang, Andreas},
	title = {Extraction of system states from natural language requirements},
	year = {2019},
	journal = {Proceedings of the IEEE International Conference on Requirements Engineering},
	volume = {2019-September},
	pages = {211 - 222},
	doi = {10.1109/RE.2019.00031},
	url = {https://www.scopus.com/pages/publications/85076923210?origin=resultslist},
	affiliations = {Technische Universität Berlin, Germany},
	abstract = {In recent years, simulations have proven to be an important means to verify the behavior of complex software systems. The different states of a system are monitored in the simulations and are compared against the requirements specification. So far, system states in natural language requirements cannot be automatically linked to signals from the simulation. However, the manual mapping between requirements and simulation is a time-consuming task. Named-entity Recognition is a sub-task from the field of automated information retrieval and is used to classify parts of natural language texts into categories. In this paper, we use a self-trained Named-entity Recognition model with Bidirectional LSTMs and CNNs to extract states from requirements specifications. We present an almost entirely automated approach and an iterative semi-automated approach to train our model. The automated and iterative approach are compared and discussed with respect to the usual manual extraction. We show that the manual extraction of states in 2,000 requirements takes nine hours. Our automated approach achieves an F1-score of 0.51 with 15 minutes of manual work and the iterative approach achieves an F1-score of 0.62 with 100 minutes of work. © 2019 IEEE.},
	author_keywords = {Named-entity Recognition; Natural Language Requirements; State Extraction; System States},
