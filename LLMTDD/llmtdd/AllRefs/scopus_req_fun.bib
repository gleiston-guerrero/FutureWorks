@ARTICLE{Ko2019431,
	author = {Ko, Deokyoon and Kim, Suntae and Park, Sooyong},
	title = {Automatic recommendation to omitted steps in use case specification},
	year = {2019},
	journal = {Requirements Engineering},
	volume = {24},
