@ARTICLE{Heimdahl200065,
	author = {Heimdahl, Mats P.E. and Czerny, Barbara J.},
	title = {On the analysis needs when verifying state-based software requirements: An experience report},
	year = {2000},
	journal = {Science of Computer Programming},
	volume = {36},
	number = {1},
	pages = {65 - 96},
	doi = {10.1016/S0167-6423(99)00018-0},
