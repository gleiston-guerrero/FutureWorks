	title = {Enhancing Manufacturing Process Efficiency through Role-Based Goal-Oriented Requirements Engineering},
	year = {2026},
	journal = {ICSIM 2026 - Proceedings of 2026 the 9th International Conference on Software Engineering and Information Management},
	pages = {392 - 398},
	doi = {10.1145/3796315.3796369},
	url = {https://www.scopus.com/pages/publications/105039444826?origin=resultslist},
	affiliations = {Reliable Software Engineering, Universitas Indonesia, West Java, Depok, Indonesia; Correctional Engineering Study Program, Politeknik Imigrasi dan Pemasyarakatan Indonesia Tangerang, Tangerang, Indonesia; Information Management Lab, Universitas Indonesia, West Java, Depok, Indonesia},
	abstract = {Information systems technology has become a vital enabler of efficient and reliable business operations by integrating data and automating complex workflows. In manufacturing environments, unmanaged and unsystematic processes can reduce efficiency, affect product quality, and expose organizations to operational risks. To address these issues, this study focuses on the development of a Manufacturing Information System that supports effective monitoring and control of manufacturing activities, minimizing human errors and unauthorized actions. This research applies the Role-Based Goal-Oriented (RBGO) method in the Requirements Engineering (RE) phase to systematically identify actors, their roles, and interdependencies. The method ensures a structured elicitation of functional and non-functional requirements aligned with organizational goals. The elicited requirements were then modeled using Unified Modeling Language (UML) diagrams specifically use case, activity, and class diagrams to capture the system from multiple perspectives. The system prototype was implemented as a desktop-based application using Delphi, supported by an SQL Server database. The application of the RBGO method produced a comprehensive set of consistent and traceable requirements. The UML models enhanced stakeholder understanding and facilitated the transition from requirement specification to system design. The developed Manufacturing Information System successfully integrated manufacturing data and improved process accountability by reducing irregularities and manual intervention. The study demonstrates that converting the RBGO method with UML modeling provides a robust foundation for designing Manufacturing Information System that are efficient, reliable, and stakeholder oriented. The approach enhances communication, clarity, and alignment throughout the development lifecycle. © 2026 Copyright held by the owner/author(s)},
	author_keywords = {information system development; manufacturing information system; requirements engineering; role-based goal-oriented method; UML modeling},
	keywords = {Engineering education; Industrial research; Information systems; Information use; Life cycle; Software prototyping; Specifications; Systems analysis; Unified Modeling Language; Goal-oriented; Information system development; Language model; Manufacturing information systems; Manufacturing process efficiencies; Requirement engineering; Role-based; Role-based goal-oriented method; Unified Modeling; Unified modeling language modeling; Requirements engineering},
	correspondence_address = {S. Sandfreni; Reliable Software Engineering, Universitas Indonesia, Depok, West Java, Indonesia; email: sandfreni@ui.ac.id},
