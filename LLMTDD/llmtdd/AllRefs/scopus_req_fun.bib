	title = {Building models we can rely on: Requirements traceability for model-based verification techniques},
	year = {2017},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
	volume = {10437 LNCS},
	pages = {3 - 18},
	doi = {10.1007/978-3-319-64119-5_1},
	url = {https://www.scopus.com/pages/publications/85029537234?origin=resultslist},
	affiliations = {Otto-von-Guericke University of Magdeburg, Magdeburg, Germany},
	abstract = {Proving the safety of a critical system is a complex and complicated task. Model-based formal verification techniques can help to verify a System Requirement Specification (SRS) with respect to normative and safety requirements. Due to an early application of these methods, it is possible to reduce the risk of high costs caused by unexpected, late system adjustments. Nevertheless, they are still rarely used. One reason among others is the lack of an applicable integration method in an existing development process. In this paper, we propose a process to integrate formal model-based verification techniques into the development life-cycle of a safety critical system. The core idea is to systematically refine informal specifications by (1) categorization, (2) structural refinement, (3) expected behavioral refinement, and finally, (4) operational semantics. To support modeling, traceability is upheld through all refinement steps and a number of consistency checks are introduced. The proposed process has been jointly developed with the German Railroad Authority (EBA) and an accredited safety assessor. We implemented an Eclipse-based IDE with connections to requirement and systems engineering tools as well as various verification engines. The applicability of our approach is demonstrated via an industrial-sized case study in the context of the European Train Control System with ETCS Level 1 Full Supervision. © 2017, Springer International Publishing AG.},
	author_keywords = {Practical experiences; Traceability; Verification},
	keywords = {Formal verification; Life cycle; Requirements engineering; Semantics; Specifications; Verification; European Train Control Systems; Model based verification; Practical experience; Requirements traceability; Safety critical systems; Structural refinement; Traceability; Verification techniques; Safety engineering},
	correspondence_address = {M. Filax; Otto-von-Guericke University of Magdeburg, Magdeburg, Germany; email: marco.filax@ovgu.de},
	editor = {Bozzano M. and Papadopoulos Y.},
	publisher = {Springer Verlag},
