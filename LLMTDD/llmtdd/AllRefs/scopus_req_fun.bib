@CONFERENCE{Kuhlen202677,
	author = {Kuhlen, David},
	title = {Examination of the Predictive Success of Potential Software-Requirement Changes Following a Requirements Analysis},
	year = {2026},
	journal = {ICSIM 2026 - Proceedings of 2026 the 9th International Conference on Software Engineering and Information Management},
	pages = {77 - 84},
	doi = {10.1145/3796315.3796327},
	url = {https://www.scopus.com/pages/publications/105039500239?origin=resultslist},
	affiliations = {Fachbereich Maschinenbau und Wirtschaft, Technische Hochschule Lübeck, Schleswig-Holstein, Lübeck, Germany},
	abstract = {Engaging with requirements plays an important role in preparing for software development. The long-term quality of software also depends on how well it aligns with future requirements. Due to the structural drawbacks involved, it is debated in the literature whether a software structure should be optimized for future hypothetical requirements. The analysis of the matter reveals that the term Software Change Request is understood in different ways. In the present work, Software Change Requests and future developments of requirements are largely treated as equivalent. This paper examines the extent to which potential requirement changes can be predicted. While some studies address this question from the perspective of software structure quality, this paper focuses on the success rate of requirements engineering in predicting change requests. To investigate the success of predicting potential requirement changes, a survey and an experiment were conducted. In the survey, dual-track bachelor students in Computer Science and Business Informatics were asked about the experiences in their training companies regarding the success of anticipating potential requirement changes. In the experiment, the students were divided into groups and tasked with analyzing a rough requirement specification and qualitatively improving it. The groups were then asked to predict possible requirement changes. The revised and improved requirement specifications were exchanged between the groups, and the prediction of potential changes was repeated. The success of the predictions was subsequently compared. The predictive success is determined by applying various methods, with the limits of the maximum achievable prediction accuracy explored based on statistical analyses. By combining the various research findings, the study concludes that at a 90% confidence level, the number of predictable change requests is between 13.132% and 87.096%. The results constitute an initial indication and require further validation, as they cannot be considered universally applicable due to the limited size of the data set. © 2026 Copyright held by the owner/author(s)},
	author_keywords = {Change Request Prediction; Requirements Engineering; Software Change Requests},
	keywords = {Computer software selection and evaluation; Predictive analytics; Software design; Software quality; Specifications; Students; Change request prediction; Quality of softwares; Requirement analysis; Requirement engineering; Requirements change; Requirements specifications; Software change; Software change request; Software requirements; Software structures; Requirements engineering},
