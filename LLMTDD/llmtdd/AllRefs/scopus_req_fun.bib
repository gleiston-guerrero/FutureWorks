	affiliations = {Señales y Sistemas (SESIS) Facultad de Informática Mazatlán, Universidad Autónoma de Sinaloa, México, 82120 Mazatlán, Mexico; Department of Computer and Information Sciences, Covenant University, Nigeria; Facultad de Informática Culiacán, Universidad Autónoma de Sinaloa, Mexico},
