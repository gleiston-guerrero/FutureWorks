@CONFERENCE{Dehlinger2005,
	author = {Dehlinger, Josh and Lutz, Robyn R.},
	title = {A product-line requirements approach to safe reuse in multi-agent systems},
	year = {2005},
	journal = {SELMAS 2005 - Proceedings of the 4th International Workshop on Software Engineering for Large-Scale Multi-Agent Systems},
	pages = {},
	doi = {10.1145/1082960.1082981},
	url = {https://www.scopus.com/pages/publications/51049105068?origin=resultslist},
	affiliations = {Dept. of Computer Science, Iowa State University, 226 Atanasoff Hall, Ames, 50011, IA, United States; Jet Propulsion Laboratory, Caltech, United States},
	abstract = {The dynamic nature of highly autonomous agents within distributed systems is difficult to specify with existing requirements techniques. However, capturing the possibly shifting configurations of agents in the requirements specification is essential for safe reuse of agents. The contribution of this work is an extensible agent-oriented requirements specification template for distributed systems that supports safe reuse. We make two basic claims for this idea. First, by adopting a product-line-like approach, it exploits component reuse during system evolution. Second, the template allows ready integration with an existing tool-supported, safety analysis technique sensitive to dynamic variations within the components (i.e., agents) of a system. To illustrate these claims, we apply the requirements specification template and safety analysis to a real-world context-aware, distributed satellite system. Copyright 2005 ACM.},
	keywords = {Autonomous agents; Safety engineering; Software agents; Software engineering; Specifications; Agent-oriented requirements; Context aware ,; Distributed satellite system; Distributed systems; Dynamic variations; Requirements specifications; Requirements techniques; System evolution; Multi agent systems},
	publisher = {Association for Computing Machinery, Inc},
