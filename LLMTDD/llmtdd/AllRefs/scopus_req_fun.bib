@ARTICLE{Singh2012213,
	author = {Singh, Sandeep K. and Sabharwal, Sangeeta and Gupta, J. P.},
	title = {A novel approach for deriving test scenarios and test cases from events},
	year = {2012},
	journal = {Journal of Information Processing Systems},
	volume = {8},
