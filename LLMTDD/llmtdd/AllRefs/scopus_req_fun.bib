	keywords = {Application programs; Autonomous vehicles; Computer vision; Formal specification; Safety engineering; Visual languages; Ambiguity; Claudeai; Completeness; GEMINI; GPT; Inconsistency; Language model; Requirement engineering; Software requirement specification; Software requirements specifications; Vision language model; Defects; Requirements engineering},
