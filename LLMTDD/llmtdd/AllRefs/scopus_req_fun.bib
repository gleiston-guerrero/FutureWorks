}

@CONFERENCE{Walter2019195,
	author = {Walter, Benedikt and Martin, Jan and Schmidt, Jonathan and Dettki, Hanna and Rudolph, Stephan},
	title = {Executable state machines derived from structured textual requirements - Connecting requirements and formal system design},
	year = {2019},
	journal = {MODELSWARD 2019 - Proceedings of the 7th International Conference on Model-Driven Engineering and Software Development},
	pages = {195 - 202},
	doi = {10.5220/0007236601950202},
	url = {https://www.scopus.com/pages/publications/85064696876?origin=resultslist},
	affiliations = {Research and Development MB Passenger Cars, Daimler AG, Kolumbusstraße 19 + 21, Sindelfingen, 71059, Germany; University of Stuttgart, IFB, Pfaffenwaldring 31, Stuttgart, 70569, Germany},
	abstract = {There exists a gap between (textual) requirements specification and systems created in the system design process. System design, particular in automotive, is a tremendously complex process. The sheer number of requirements for a system is too high to be considered at once. In industrial contexts, complex systems are commonly created through many design iterations with numerous hardware samples and software versions build. System experts include many experience-based design decisions in the process. This approach eventually leads to a somewhat consistent system without formal consideration of requirements or a traceable design decision process. The process leaves a de facto gap between specification and system design. Ideally, requirements constrain the initial solution space and system design can choose between the design variants consistent with that reduced solution space. In reality, the true solution space is unknown and the effect of particular requirements on that solution space is a guessing game. Therefore, we want to propose a process chain that formally includes requirements in the system design process and generates an executable system model. Requirements documented as structured text are mapped into the logic space. Temporal logic allows generation of consistent static state machines. Extracting and modelling input/output signals of that state machine enables us to generate an executable system model, fully derived from its requirements. This bridges the existing gap between requirements specification and system design. The correctness and usefulness of this approach is shown in a case study on automotive systems at Daimler AG. Copyright © 2019 by SCITEPRESS - Science and Technology Publications, Lda. All rights reserved},
	author_keywords = {Executable Finite State Machines; Formalization; Requirements Engineering; System Design},
	keywords = {Bridges; Computer circuits; Design; Requirements engineering; Specifications; Systems analysis; Automotive Systems; Complex Processes; Executable systems; Formalization; Industrial context; Requirements specifications; Software versions; System design process; Software design},
	editor = {Hammoudi S. and Pires L.F. and Selic B.},
	publisher = {SciTePress},
	isbn = {978-989758358-2},
	language = {English},
	abbrev_source_title = {MODELSWARD - Proc. Int. Conf. Model-Driven Eng. Softw. Dev.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access; Gold Open Access}
}

@CONFERENCE{Gordon-Kiwkowitz202127,
	author = {Gordon-Kiwkowitz, Michal and Harel, David},
	title = {Behavioral programming with a subset of natural language: An evaluation study},
	year = {2021},
	journal = {14th IADIS International Conference Information Systems 2021, IS 2021},
	pages = {27 - 34},
	url = {https://www.scopus.com/pages/publications/85117401984?origin=resultslist},
	affiliations = {Holon Institute of Technology, Holon, Israel; Weizmann Institute of Science, Rehovot, Israel},
	abstract = {We consider the idea of behavioral programming by writing controlled natural language requirements, which are then compiled directly into executable code. Our motivation is to bridge the gap between system requirements and a final system. We claim that formal structured natural language requirements can serve as the means and the end to programming the behavior of reactive systems, if one utilizes a fully executable language that supports story-like sentences, such as live sequence charts (LSC). We use natural language processing methods combined with user interaction in order to understand English requirements, and translate them into LSCs, disambiguating and clarifying intentions with the user when necessary. We test a multi-modal user interface we term show & tell, where natural language is interspersed with play-in, and model-based co-reference resolution. Our approach is domain general and builds the underlying model of the system leading to direct execution. The paper presents novel evaluation studies that show its potential as an effective tool for natural language programming of reactive system behavior.  © 14th IADIS International Conf. Infor. Sys. 2021. All rights reserved.},
	author_keywords = {Behavioral Programming; Controlled Natural Language; Human Computer Interfaces; Live Sequence Charts; Modeling; Scenario-Based Programming},
	keywords = {Behavioral research; Flowcharting; Human computer interaction; Natural language processing systems; Requirements engineering; User interfaces; Visual languages; Behavioral programming; Controlled natural language; Evaluation study; Human computer interfaces; Live sequence chart; Modeling; Natural language requirements; Natural languages; Reactive system; Scenario-based programming; Modeling languages},
