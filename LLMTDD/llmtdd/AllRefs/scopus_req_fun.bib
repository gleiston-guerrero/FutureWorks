	title = {FRUIT: Fuzzy representation of unbounded and imprecise terms in non-functional requirements},
	year = {2024},
	journal = {IEEE Access},
	volume = {12},
	pages = {182779 - 182787},
	doi = {10.1109/ACCESS.2024.3511035},
	url = {https://www.scopus.com/pages/publications/85211465962?origin=resultslist},
	affiliations = {Grupo de Investigación en Inteligencia Artificial, Facultad de Ciencias Matemáticas y Físicas, Universidad de Guayaquil, Guayaquil, 090313, Ecuador; Centro de Estudios de Didáctica y Gestión de la Educación Superior, Universidad Bolivariana Del Ecuador, Duran, 092405, Ecuador; Centro de Estudios en Tecnologías Aplicadas, Universidad Bolivariana Del Ecuador, Duran, 092405, Ecuador; SIMUEES Simulation Clinic, Universidad Espíritu Santo, Samborondón, 092301, Ecuador},
	abstract = {It is challenging to verify Non-Functional Requirements (NFRs) because the traditional verification process typically uses the binary concept of true or false to determine whether a requirement has been fulfilled, leaving no space for uncertainty, even in the slightest, such as partially positive or partially negative evaluations. Therefore, it is necessary to consider fuzzy logic to provide the opportunity to verify NFRs in a more flexible manner. To do this, the present manuscript exposes a methodology called the Fuzzy Representation of Unbounded and Imprecise Terms (FRUIT). It expands the PROSE structure, which we first presented in our earlier work, to enable the defining of user NFRs in natural language (NL) when considering fuzzy logic to make more flexible the evaluation of quantitative NFRs and enable the evaluation of qualitative NFRs. To define NFRs under the FRUIT methodology, we need to select the system property, metrics (linguistic variables), and fuzzy set that enable the evaluation of the NFR. A table containing attributes, metrics, and linguistic values is supplied to aid in its definition; the stakeholders and elicitors are tasked with defining the boundaries of each linguistic value. To evaluate the FRUIT methodology, 44 group projects from the required engineering courses offered between 2022 and 2024 at the University of Guayaquil were looked at by experts. According to the results, students decreased the proportion of bad NFRs from approximately 80% to 10%. In conclusion, the results show how important the FRUIT methodology is for helping students to define NFRs in NL while making more flexible the evaluation of NFRs. ©2024 The Authors.},
	author_keywords = {Fuzzy logic; Non-functional requirements; Requirement engineering; Requirement specification; Software engineering.},
	keywords = {Engineering education; Fuzzy logic; Fuzzy sets; Requirements engineering; Verification; Fuzzy representations; Fuzzy-Logic; Linguistic values; Natural languages; Non-functional requirements; Requirement engineering; Requirements specifications; System property; Uncertainty; Verification process},
