address = {GBR},
abstract = {Object-oriented analysis and design (OOAD) is a software engineering approach to constructing software systems by building object-oriented models that abstract key aspects of the target system and by using the models to guide the development process. The model concepts and the notation are intended to capture design decisions that have a large impact on the final system.},
