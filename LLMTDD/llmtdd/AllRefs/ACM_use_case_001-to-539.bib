@article{10.1145/2464526.2464535,
author = {Rao, V. Bhujanga and Ramaiah, P. Seetha and Kumar, K. Raja},
title = {Clinical programming software to manage patient's data with a Cochlear implantat},
year = {2013},
issue_date = {May 2013},
publisher = {Association for Computing Machinery},
