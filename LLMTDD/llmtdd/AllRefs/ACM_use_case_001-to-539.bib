editor = {Awdren Font\~{a}o, D\'{e}bora Paiva, Hudson Borges, Maria Istela, Patr\'{\i}cia Gomes, Vanessa Borges, Silvana M. Melo, Vin\'{\i}cius Durelli and Edna Dias Canedo},
