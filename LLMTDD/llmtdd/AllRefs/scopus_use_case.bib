	keywords = {Codes (symbols); Interoperability; Middleware; Specifications; Translation (languages); Application platforms; Internet of Things (IOT); Service functions; Service middlewares; Smart objects; User experience; Internet of things},
	correspondence_address = {C. Gonzalez Garcia; Department of Computer Science, University of Oviedo, Oviedo, 33007, Spain; email: gonzalezcristian@uniovi.es},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {23274662},
