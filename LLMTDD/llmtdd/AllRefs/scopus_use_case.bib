@CONFERENCE{Kassab200518,
	author = {Kassab, Mohamad and Constantinides, Constantinos and Ormandjieva, Olga},
	title = {Specifying and separating concerns from requirements to design: A case study},
	year = {2005},
	journal = {Proceedings of the Second IASTED International Multi-Conference on Automation, Control, and Information Technology, ACIT 2005},
	pages = {18 - 27},
	url = {https://www.scopus.com/pages/publications/33244465564?origin=resultslist},
	affiliations = {Department of Computer Science and Software Engineering, Concordia University, Montreal, Que. H3G 1MS, 1455 de Maisonneuve Blvd West, Canada},
	abstract = {Oriented Software Development (AOSD) aims at providing a systematic support for the identification, separation, representation (through proper modeling and documentation), and composition of crosscutting concerns as well as mechanisms that can make them traceable throughout software development. In this paper, we discuss a sequence of systematic activities towards an early consideration of specifying and separating crosscutting functional requirements (FRs) and nonfunctional requirements (NFRs). This approach would make it possible to identify and resolve conflicts between NFRs earlier in the development cycle and can promote traceability of broadly scoped requirements throughout system development, maintenance and evolution. We provide a formalism for FRs by specifying their pre- and postconditions using first-order predicate logic. Measures of conflictiveness and interdependency are proposed to assess the effort required for the composition of the requirements. A new measure of cohesiveness of the use-case model is proposed based on the crosscutting modeling approach.},
	keywords = {Computer simulation; Computer software; Software engineering; Sustainable development; Functional requirements (FRs); Nonfunctional requirements (NFRs); System development; Systems analysis},
	correspondence_address = {M. Kassab; Department of Computer Science and Software Engineering, Concordia University, Montreal, Que. H3G 1MS, 1455 de Maisonneuve Blvd West, Canada; email: moh_kass@cs.concordia.ca},
	isbn = {0889864756},
	language = {English},
	abbrev_source_title = {Proc. Int. Multi-Conf. Autom. Control Inf. Tech.},
	type = {Conference paper},
	publication_stage = {Final},
