	abbrev_source_title = {ACIS Int. Conf. Softw. Eng. Res., Manage. Appl., SERA},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@CONFERENCE{Cruz2015338,
