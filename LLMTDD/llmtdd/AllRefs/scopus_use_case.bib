	title = {Bridging the gap between a set of interrelated business process models and software models},
	year = {2015},
	journal = {ICEIS 2015 - 17th International Conference on Enterprise Information Systems, Proceedings},
	volume = {2},
	pages = {338 - 345},
	doi = {10.5220/0005378103380345},
	url = {https://www.scopus.com/pages/publications/84939531161?origin=resultslist},
	affiliations = {Instituto Politécnico de Viana do Castelo, Viana do Castelo, Portugal; Centro ALGORITMI, Escola de Engenharia, Universidade do Minho, Guimarães, Portugal},
	abstract = {A business process model identifies the activities, resources and data involved in the creation of a product or service, having lots of useful information for starting to develop a supporting software system. With regard to software development, one of the most difficult and crucial activities is the identification of system functional requirements. A popular way to capture and describe those requirements is through UML use case models. Usually an organization deals with several business processes. As a consequence, a software product does not usually support only one business process, but rather a set of business processes. This paper presents an approach that allows aggregating in one use case model all the information that can be extracted from the set of business process models that will be supported by the software under development. The generated use case model serves as a basis for the software development process, helping reducing time and effort spent in requirements elicitation. The approach also helps to ensure the alignment between business and software, and enables traceability between business processes and the corresponding elements in software models. Copyright © 2015 SCITEPRESS - Science and Technology Publications.},
	author_keywords = {BPMN; Business process modeling; Requirements elicitation; UML; Use case model},
	keywords = {Information use; Requirements engineering; Systems engineering; BPMN; Business process model; Functional requirement; Identification of systems; Requirements elicitation; Software development process; Software products; Use case model; Software design},
	editor = {Hammoudi S. and Maciaszek L. and Maciaszek L. and Teniente E.},
	publisher = {SciTePress},
	isbn = {978-989758096-3},
	language = {English},
	abbrev_source_title = {ICEIS - Int. Conf. Enterp. Inf. Syst., Proc.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 19; All Open Access; Gold Open Access}
}

