	keywords = {Application programs; Artificial intelligence; Automatic test pattern generation; Natural language processing systems; Requirements engineering; Software testing; Language model; Large language model; Natural language requirements; Natural languages; Software requirements; Test case; UML; UML use case; Use case; Use case specifications; Specifications},
	correspondence_address = {H. Li; College of Computer Science and Technology, Huaqiao University, Xiamen, 361021, China; email: lihaibo@hqu.edu.cn},
