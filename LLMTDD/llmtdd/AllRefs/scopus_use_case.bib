@CONFERENCE{Seresht2008133,
	author = {Seresht, Shadi Moradi and Ormandjieva, Olga and Sabra, Samer},
	title = {Automatic conceptual analysis of user requirements with the Requirements Engineering Assistance Diagnostic (READ) tool},
