	title = {Research on the Application of Object-Oriented Modeling in Smart Agricultural Greenhouse Systems},
	year = {2026},
	journal = {2026 6th International Symposium on Computer Technology and Information Science, ISCTIS 2026},
	pages = {1334 - 1340},
	doi = {10.1109/ISCTIS70043.2026.11572711},
	url = {https://www.scopus.com/pages/publications/105044602906?origin=resultslist},
	affiliations = {Xi'an Eurasia University, School Of Information Engineering, Xi'an, China},
	abstract = {Aiming at the development requirements of the smart agricultural greenhouse system, this study proposes an enhanced object-oriented modeling framework that extends standard UML with domain-specific constraints to support model-driven development (MDD) for IoT systems. Through an in-depth analysis of the agricultural greenhouse business processes, the functional and non-functional requirements of the system are identified, and a comprehensive use case model is constructed. Building on this, the Unified Modeling Language (UML) is employed to establish both static structural and dynamic behavioral models of the system. Special attention is paid to the application of design patterns in system modeling, with the introduction of classic patterns such as the strategy pattern and the factory pattern to optimize the system architecture design. Practical results indicate that the system analysis method based on object-oriented modeling can effectively capture user requirements, establish clear system boundaries, and enhance the quality and maintainability of software design. Experimental validation demonstrates that the proposed MDD approach can reduce average system response latency by 32% and achieve 78% model-to-code conversion coverage. This research provides a concrete case reference and a methodological enhancement for the application of object-oriented modeling methods in the requirements analysis of Internet of Things (IoT) systems. © 2026 IEEE.},
	author_keywords = {Design Patterns; Object-Oriented Modeling; Requirements Analysis; Smart Agriculture; Unified Modeling Language (UML)},
	keywords = {Agriculture; Internet of things; Object oriented programming; Requirements engineering; Smart agriculture; Software design; Software quality; Systems analysis; Agricultural greenhouse; Design Patterns; Domain specific; Model-driven-development; Modelling framework; Object oriented modelling; Requirement analysis; Smart agricultures; Unified Modeling; Unified modeling language; Unified Modeling Language},
	correspondence_address = {X. Ma; Xi'an Eurasia University, School Of Information Engineering, Xi'an, China; email: maxiaoju@eurasia.edu},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833154711-0},
