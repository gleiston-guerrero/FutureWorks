@CONFERENCE{Whittle2008121,
	author = {Whittle, Jon and Wijesekera, Duminda and Hartong, Mark},
	title = {Executable misuse cases for modeling security concerns},
	year = {2008},
	journal = {Proceedings - International Conference on Software Engineering},
	pages = {121 - 130},
	doi = {10.1145/1368088.1368106},
	url = {https://www.scopus.com/pages/publications/57349132966?origin=resultslist},
	affiliations = {Dept. of Computing, Lancaster University, Lancaster, LA1 4WA, United Kingdom; Dept. of Information and Software Engineering, George Mason University, Fairfax, VA 22030, United States; Federal Railroad Administration, Washington, DC 20590, 1120 Vermont Ave, United States},
	abstract = {Misuse cases are a way of modeling negative requirements, that is, behaviors that should not occur in a system. In particular, they can be used to model attacks on a system as well as the security mechanisms needed to avoid them. However, like use cases, misuse cases describe requirements in a high-level and informal manner. This means that, whilst they are easy to understand, they do not lend themselves to testing or analysis. In this paper, we present an executable misuse case modeling language which allows modelers to specify misuse case scenarios in a formal yet intuitive way and to execute the misuse case model in tandem with a corresponding use case model. Misuse scenarios are given in executable form and mitigations are captured using aspect-oriented modeling. The technique is useful for brainstorming potential attacks and their mitigations. Furthermore, the use of aspects allows mitigations to be maintained separately from the core system model. The paper, supported by a UML-based modeling tool, describes an application to two case studies, providing evidence that the technique can support red-teaming of security requirements for realistic systems. Copyright 2008 ACM.},
	author_keywords = {Early aspects; Misuse cases; Scenarios},
	keywords = {Decision making; Model structures; Software engineering; Computer software; Formal logic; Aspect-oriented modeling; Core systems; Early aspects; Misuse cases; Modeling languages; Modeling tools; Potential attacks; Realistic systems; Scenarios; Security mechanisms; Security requirements; Use case models; Aspect oriented modeling; Misuse case; Modeling tool; Potential attack; Security mechanism; Use case model; Formal logic; Mathematical models},
