	title = {Semantic Relation Extraction for Use Case Modeling: A PlantUML-based Automation Framework},
	year = {2025},
	journal = {INDISCON 2025 - IEEE 6th India Council International Subsections Conference, Proceedings},
	pages = {},
	doi = {10.1109/INDISCON66021.2025.11253567},
	url = {https://www.scopus.com/pages/publications/105030204957?origin=resultslist},
	affiliations = {Amrita School of Computing, Department of Computer Science and Applications, Amrita Vishwa Vidyapeetham Amritapuri Campus, Kollam, India},
	abstract = {Use case diagrams are a foundational component in early-stage software design, providing a visual representation of system functionalities and user interactions. Manually constructing these diagrams from requirement documents can be time-consuming and susceptible to inconsistencies, especially in large or evolving systems. This paper proposes an automated approach that extracts relevant relationships from natural language software specifications and generates corresponding use case diagrams. The method combines dependency parsing, rule-based filtering of subject-verb-object triplets, and a local large language model to produce syntactically valid PlantUML code. The system was evaluated using five publicly available requirement documents. Performance was measured in terms of precision, recall, and F 1 -score, achieving average values of 89.6%, 87.2%, and 88.6%, respectively. A semantic assessment using GEval resulted in an average score of 83.14%, indicating that the generated diagrams maintain consistency with benchmark expectations. The proposed solution demonstrates that structured preprocessing combined with language modeling techniques can significantly reduce manual effort in diagram creation while supporting clarity and correctness in software design artifacts.  © 2025 IEEE.},
	author_keywords = {Natural Language Processing; PlantUML; Relation Extraction; Software Requirements; Use case diagram generation},
	keywords = {Computational linguistics; Extraction; Graphic methods; Modeling languages; Requirements engineering; Semantics; Software design; Syntactics; Language model; Language processing; Natural language processing; Natural languages; Plantuml; Relation extraction; Requirements document; Software requirements; Use case diagram generation; Use cases diagrams; Natural language processing systems},
