@ARTICLE{Rago2016579,
	author = {Rago, Alejandro and Marcos, Claudia and Diaz-Pace, J. Andres},
	title = {Identifying duplicate functionality in textual use cases by aligning semantic actions},
	year = {2016},
	journal = {Software and Systems Modeling},
	volume = {15},
