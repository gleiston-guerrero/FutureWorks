	publisher = {Slovak Academy of Sciences},
	issn = {13359150},
	language = {English},
	abbrev_source_title = {Comput. Inf.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 13}
}

