@inproceedings{10.1145/3786182.3788309,
author = {Oliveira, Rhenara Alves and Carvalho, Rainara M. and Cardoso, Julian C\'{e}sar P. and Gurgel, Juliana Lopes and Santos, Ismayle S. and Andrade, Rossana M. C.},
title = {An Exploratory Study on Requirements Reuse: Comparing Manual and ChatGPT-Based Approaches},
year = {2026},
isbn = {9798400724138},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3786182.3788309},
doi = {10.1145/3786182.3788309},
abstract = {The reuse of software requirements is an essential practice to increase efficiency and consistency in the development of similar systems. However, adapting previously specified requirements to new contexts still demands considerable effort in analysis and reformulation by requirements engineers. This study investigates the potential of large language models (LLMs), particularly ChatGPT, to support and automate requirements reuse through the transformation of existing use cases into user stories across similar platforms in the context of Brazilian public administration. To this end, a comparative exploratory study was conducted between two approaches: (i) manual reuse of requirements, performed by human experts, and (ii) automated reuse assisted by ChatGPT, using the same set of requirements from an existing platform as a basis. The comparison considers criteria such as precision, recall, human effort involved and quantity of information. Thus, this study contributes to the understanding of the role of AI in Requirements Engineering, particularly regarding requirements reuse, and proposes a reusable prompt to support this task.},
booktitle = {Proceedings of the 3rd Workshop on Multi-Disciplinary, Open, and IntegRatEd Requirements Engineering},
pages = {1–5},
numpages = {5},
keywords = {Requirements Engineering, Requirements Reuse, LLMs, GPT-5},
location = {
},
series = {MO2RE '26}
}

