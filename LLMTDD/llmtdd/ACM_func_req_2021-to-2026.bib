@proceedings{10.1145/3786181,
title = {LLM4Code '26: Proceedings of the 3rd International Workshop on Large Language Models For Code},
year = {2026},
isbn = {9798400724121},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
abstract = {Welcome to the third edition of the International Workshop on Large Language Models for Code (LLM4Code), co-located with the 48th International Conference on Software Engineering (ICSE 2026). Large Language Models (LLMs) have achieved significant advances in Software Engineering (SE) area. Over the past few years, there is a growing interest in applying LLMs to assist software development and maintenance, such as code generation and comprehension, test generation, as well as program repair. The motivation of this workshop is to provide a platform for academics and practitioners to discuss and share their ideas on applying and developing LLMs to solve code-relevant problems in SE activities. This workshop is concerned with research on: (1) how to better apply LLMs to solve code-relevant tasks; (2) how to design better LLMs for code-relevant tasks; (3) how to better benchmark LLMs on code-relevant tasks.This workshop aims to provide an opportunity for participants to discuss novel ideas and preliminary results on LLMs for solving code-relevant SE problems, so as to exchange the latest progress in this domain. Moreover, this workshop aims to encourage participants to discuss the open challenges and problems of LLM4code, so as to identify important future directions in this domain. Finally, this workshop aims to encourage participants to share infrastructures and benchmarks that are foundational and beneficial for future research in this domain.},
location = {
