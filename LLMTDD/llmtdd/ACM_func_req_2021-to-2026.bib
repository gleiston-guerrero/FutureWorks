editor = {Sujit Kumar Chakrabarti, Aseem Rastogi, Sudipto Ghosh, Raghavan Komondoor, Raveendra Kumar Medicherla, Lov Kumar and Sangharatna Godboley},
title = {ISEC '24: Proceedings of the 17th Innovations in Software Engineering Conference},
