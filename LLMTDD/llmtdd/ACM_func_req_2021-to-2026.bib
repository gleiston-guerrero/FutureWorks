@inproceedings{10.1145/3571473.3571501,
author = {Paiva, Joseane O. V. and Borges, Bosco and Duarte, Paulo and S. Santos, Ismayle and M. C. Andrade, Rossana and Lelli, Val\'{e}ria},
title = {PRO-UX: System Redesign Process for Improving the UX},
year = {2023},
