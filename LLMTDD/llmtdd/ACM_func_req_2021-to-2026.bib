isbn = {9781450398091},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3568739.3568793},
doi = {10.1145/3568739.3568793},
abstract = {Art class is a teaching system with aesthetic teaching as the core and painting, craft and appreciation as the same emphasis. It is an integrated education of aesthetics and art review, and plays an important role in improving the comprehensive quality of students. In today's information-based society, it is very necessary for schools to establish corresponding curriculum websites for primary school art courses that require hands-on participation and communication. This can not only enable more people to enjoy valuable educational resources, but also help to improve the teaching quality of school art courses and improve students' imagination, appreciation, expression and practical ability. The course website uses software to design the page, database and programming language to realize the website. The website mainly includes three parts: homework management system, website page system and learning forum system. The function of the designed system is tested and the performance is analyzed. This system enhances the interactive effect of art class, improves the teaching effect of the course, and is of great significance to promote the further development of art class teaching and multimedia teaching.},
